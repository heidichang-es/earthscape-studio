<script>
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;

  if (lb) {
    const imgs = Array.from(lb.querySelectorAll<HTMLElement>('[data-lb-img]'));
    const indexEl = lb.querySelector<HTMLElement>('[data-lb-index]');
    let cur = 0;

    const show = (i: number) => {
      if (!imgs.length) return;
      cur = (i + imgs.length) % imgs.length;
      imgs.forEach((im, k) => im.classList.toggle('active', k === cur));
      if (indexEl) indexEl.textContent = String(cur + 1);
    };

    document.querySelectorAll<HTMLElement>('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.shot));
        lb.showModal();
      });
    });

    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(cur - 1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(cur + 1));
    lb.querySelector('[data-lb-close]')?.addEventListener('click', () => lb.close());

    // Clicking the surrounding area — not a control or the picture — closes it
    lb.addEventListener('click', (e) => {
      if (e.target === lb || (e.target as HTMLElement).classList.contains('lb-stage')) lb.close();
    });

    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); }
    });
  }
</script>
