const works = await getCollection('works');

// Group by series, sort within each by canonical type order then serial
const typeOrder = ['LV', 'MV', 'CP', 'BW', 'JR', 'OB'];
const typeLabels: Record<string, string> = {
  LV: 'Large Vessel · 大型花器',
  MV: 'Mid Vessel · 中型花器',
  CP: 'Cup · 杯',
  BW: 'Bowl · 缽',
  JR: 'Jar · 罐',
  OB: 'Object · 擺件',
};

// Short English markers shown on the thumbnail; `available` stays unmarked
const statusMarker: Record<string, string> = {
  sold: 'Collected',
  reserved: 'Reserved',
  'artist-hold': "Artist's hold",
  consignment: 'On consignment',
  'not-for-sale': 'Not for sale',
};

const bySeries = new Map<string, typeof works>();
for (const w of works) {
  if (!bySeries.has(w.data.series)) bySeries.set(w.data.series, []);
  bySeries.get(w.data.series)!.push(w);
}
for (const list of bySeries.values()) {
  list.sort((a, b) => {
    const t = typeOrder.indexOf(a.data.type) - typeOrder.indexOf(b.data.type);
    return t !== 0 ? t : a.data.serial.localeCompare(b.data.serial);
  });
}

// Planned inventory per series (hardcoded for Cape · 01 right now;
// when more series ship, drive this from a separate config or series collection)
const plannedInventory: Record<string, Record<string, number>> = {
  // UD = the 8 "Undefined" pieces on the cover inventory; not a filed type yet,
  // counted here so the planned total matches the 64 shown on the home page
  'Cape · 01 — Gathering The Food': { LV: 8, MV: 16, CP: 8, BW: 8, JR: 8, OB: 8, UD: 8 },
};

function plannedTotal(series: string): number {
  const inv = plannedInventory[series] ?? {};
  return Object.values(inv).reduce((a, b) => a + b, 0);
}
---

<BaseLayout
  title="Works · 作品目錄 — Earthscape Studio"
  description="Catalog of works from Earthscape Studio. 所有作品依系列、類別與藏品編號編列。"
  active="works"
>
  <Breadcrumb slot="top" current="Works" acc={`CAT · ${works.length} OF ${plannedTotal('Cape · 01 — Gathering The Food')}`} />

  <!-- HERO -->
  <section class="catalog-hero">
    <span class="label-strong">§ Catalog · 作品目錄</span>
    <h1><em>The</em> Catalog</h1>
    <div class="hero-zh zh">作 品 目 錄</div>
    <p class="hero-desc">
      All works archived by series, type and accession number.<br />
      所有作品依系列、類別與藏品編號編列。
    </p>
  </section>

  <!-- REFERENCE · CAPE · 01 -->
  <section class="series-reference">
    <SectionHead num="§ Cape · 01"><em>Gathering The Food</em> · 儲物</SectionHead>

    <div class="reference-grid">
      <figure class="reference-figure">
        <Image
          class="reference-img"
          src={seriesGroup}
          alt="Five coil-built storage vessels grouped on a cloth-covered table"
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="lazy"
        />
        <figcaption class="reference-caption label">Cape · 01 · 儲物 · 2026</figcaption>
      </figure>

      <div class="reference-note">
        <p class="zh">
          靈感來源於古地中海到近東一帶用來保存運送糧食、橄欖油與葡萄酒的器物。厚實圓潤的外型與樸拙的紋理都讓我覺得十分著迷——材質可能是陶、玄武岩、大理石，也可能是細膩的雪花石膏。<br>
          從最貼近原型的大花器開始製作第一批作品，擷取並且調整成可以好好站著的實用花器，期待花與葉的生命力填滿完整作品！
        </p>

        <p class="reference-stories zh">
          蒐集資料與製作時，有幾個有趣的小知識想分享。
        </p>

        <ol class="reference-stories zh">
          <li>
            這批器物從米黃、赭紅、深褐到近黑的強烈差異，並非來自不同的釉，而是化妝土中鐵含量的多寡——在相同的基底化妝土中，分別添加 2%～10% 不等的氧化鐵（還有微量氧化錳），最後呈現出氣質十分不同的色彩效果。
          </li>
          <li>
            雙耳罐的耳朵未必是把手——有時候看到某些高罐的耳朵小到很幽默，讓人困惑它到底是用來做什麼的；查找後才發現，在許多古代器物上，它更常是為了綁繩封口而存在。
          </li>
          <li>
            關於高瘦甚至尖底的瓶罐，一眼望去真的是看不懂它們為什麼會做成這樣站不住的造型，閱讀資料後才知道：它們不需要「站好」。作為儲藏的用品，它們的舞台並不是日常的桌面或是櫥櫃，而是半埋在倉庫、酒窖的砂土中；在船艙裡層層互相咬合、彼此支撐，穩穩度過整趟地中海的航行。
          </li>
        </ol>

        <div class="reference-keywords label">
          Egyptian · Chypriote · Badarian · Nagada · Enkomi · Ktima
        </div>

        <span class="reference-source label">Inspiration · Musée du Louvre</span>

        <ul class="visit-shots">
          {visitShots.map((s, i) => (
            <li>
              <button
                type="button"
                class="visit-shot"
                data-shot={i}
                aria-label={`放大第 ${i + 1} 張，共 ${visitShots.length} 張`}
              >
                <Image src={s.src} alt={s.alt} widths={[160, 320, 640]} sizes="120px" loading="lazy" />
              </button>
            </li>
          ))}
        </ul>

        <span class="reference-source label">
          最早的製作靈感來源，應該可以追溯到 2024 年的小歐旅，在暈呼呼時差攻擊下抵達羅浮宮。一進去就被卡在近東文物的陷阱中！一切都好新奇好迷人：經過土壤與時間醃漬發酵的大理石紋理，敦厚的口緣搭配飽滿的造型，突然之間獲得了好多很棒的搜尋關鍵字。
        </span>

      </div>
    </div>

    <ul class="reference-cards">
      {references.map((r) => (
        <li>
          <a class="ref-card" href={r.url} target="_blank" rel="noopener noreferrer">
            {r.paths && (
              <span class="ref-card-glyph">
                <svg viewBox={r.viewBox} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                  {r.paths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
                </svg>
              </span>
            )}
            <span class="ref-card-inv label">{r.inv}</span>
            <span class="ref-card-title">{r.title}</span>
            <span class="ref-card-period">{r.period}</span>
            <span class="ref-card-material">{r.material}</span>
            <span class="ref-card-dim label">{r.dim}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Lightbox for the gallery snapshots -->
    <dialog class="lightbox" id="lightbox" aria-label="Gallery snapshots">
      <button type="button" class="lb-close" data-lb-close aria-label="關閉">✕</button>
      <button type="button" class="lb-nav prev" data-lb-prev aria-label="上一張">‹</button>

      <div class="lb-stage">
        {visitShots.map((s, i) => (
          <Image
            class="lb-img"
            data-lb-img={i}
            src={s.src}
            alt={s.alt}
            widths={[800, 1200, 1800]}
            sizes="92vw"
            loading="lazy"
          />
        ))}
      </div>

      <button type="button" class="lb-nav next" data-lb-next aria-label="下一張">›</button>
      <div class="lb-count label"><span data-lb-index>1</span> / {visitShots.length}</div>
    </dialog>
  </section>

  {Array.from(bySeries.entries()).map(([series, items]) => {
    const planned = plannedInventory[series] ?? {};
    const plannedSum = plannedTotal(series);
    return (
      <section class="series-catalog">
        <div class="series-summary">
          <div class="summary-line">
            <span class="summary-num">{items.length}</span>
            <span class="summary-of label">of</span>
            <span class="summary-num">{plannedSum}</span>
            <span class="summary-label label">pieces completed</span>
          </div>
          <div class="summary-inventory">
            {typeOrder.map(t => {
              const made = items.filter(i => i.data.type === t).length;
              const total = planned[t] ?? 0;
              if (total === 0) return null;
              return (
                <div class="inv-cell">
                  <span class="inv-type label">{t}</span>
                  <span class="inv-progress">{made}/{total}</span>
                </div>
              );
            })}
          </div>
        </div>

        <div class="catalog-grid">
          {items.map(w => (
            <a href={`/works/${w.id}`} class="catalog-card">
              <div class="card-thumb">
                {w.data.images.length > 0 ? (
                  <Image
                    class="card-thumb-img"
                    src={w.data.images[0].src}
                    alt=""
                    widths={[300, 600]}
                    sizes="(max-width: 600px) 45vw, 260px"
                    loading="lazy"
                  />
                ) : (
                  <span class="thumb-glyph">◇</span>
                )}
                <span class="thumb-type label">{w.data.type} · {w.data.serial}</span>
                {statusMarker[w.data.status] && (
                  <span class={`thumb-status label is-${w.data.status}`}>{statusMarker[w.data.status]}</span>
                )}
              </div>
              <div class="card-acc label">{w.data.accession.replace(/^ES · \d+ · /, '')}</div>
              <h3 class="card-name">{w.data.title}</h3>
              <div class="card-name-zh zh">{w.data.titleZh}</div>
              {w.data.dimensions && <div class="card-dim">{w.data.dimensions}</div>}
            </a>
          ))}

          {items.length < plannedSum && (
            <div class="catalog-card planned">
              <div class="card-thumb">
                <span class="thumb-glyph">·</span>
                <span class="thumb-type label">{plannedSum - items.length} forthcoming</span>
              </div>
              <div class="card-acc label">尚未編列</div>
              <h3 class="card-name">In Production</h3>
              <div class="card-name-zh zh">製 作 中</div>
            </div>
          )}
        </div>
      </section>
    );
  })}
</BaseLayout>

