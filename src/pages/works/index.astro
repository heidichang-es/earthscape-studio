---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHead from '../../components/SectionHead.astro';
import seriesGroup from '../../assets/works/cape-01/series-2.jpg';

// Reference objects behind Cape · 01, as catalogued by the Musée du Louvre
const references = [
  {
    title: 'Jarre',
    period: 'Nagada I–II A–B · −3800 / −3600',
    material: 'Basalte',
    dim: 'H 42.8 cm',
    inv: 'E 23175',
    url: 'https://collections.louvre.fr/en/ark:/53355/cl010003854',
  },
  {
    title: 'Jarre à anse',
    period: 'Nagada II C–D · −3600 / −3200',
    material: 'Basalte',
    dim: 'H 14 cm',
    inv: 'E 10801 8',
    url: 'https://collections.louvre.fr/en/ark:/53355/cl010011510',
  },
  {
    title: 'Jarre ; bouteille',
    period: 'VIe dynastie · −2413 / −2250',
    material: 'Albâtre égyptien',
    dim: 'H 28 cm',
    inv: 'E 10931',
    url: 'https://collections.louvre.fr/en/ark:/53355/cl010008193',
  },
  {
    title: 'Cruche cannelée',
    period: 'Enkomi, tombe 5 · fouille 1949',
    material: 'Terre cuite, engobe',
    dim: 'H 19.2 cm',
    inv: 'AM 2321',
    url: 'https://collections.louvre.fr/en/ark:/53355/cl010131722',
  },
  {
    title: "Cruchon « white shaved »",
    period: 'Bronze récent · −1550 / −1150',
    material: 'Terre cuite raclée',
    dim: 'H 15.5 cm',
    inv: 'AM 2289',
    url: 'https://collections.louvre.fr/en/ark:/53355/cl010131662',
  },
  {
    title: 'Cruche monochrome',
    period: 'Chypro-géométrique · Ktima, tombe IV',
    material: 'Terre cuite',
    dim: 'H 16.5 cm',
    inv: 'AM 1889',
    url: 'https://collections.louvre.fr/en/ark:/53355/cl010131274',
  },
];

const works = await getCollection('works');

// Group by series, sort within each by canonical type order then serial
const typeOrder = ['LV', 'MV', 'CP', 'BW', 'JR', 'OB'];
const typeLabels: Record<string, string> = {
  LV: 'Large Vessel · 大型花器',
  MV: 'Mid Vessel · 中型花器',
  CP: 'Cup · 杯',
  BW: 'Bowl · 缽',
  JR: 'Jar · 罐',
  OB: 'Object · 擺件',
};

const bySeries = new Map<string, typeof works>();
for (const w of works) {
  if (!bySeries.has(w.data.series)) bySeries.set(w.data.series, []);
  bySeries.get(w.data.series)!.push(w);
}
for (const list of bySeries.values()) {
  list.sort((a, b) => {
    const t = typeOrder.indexOf(a.data.type) - typeOrder.indexOf(b.data.type);
    return t !== 0 ? t : a.data.serial.localeCompare(b.data.serial);
  });
}

// Planned inventory per series (hardcoded for Cape · 01 right now;
// when more series ship, drive this from a separate config or series collection)
const plannedInventory: Record<string, Record<string, number>> = {
  // UD = the 8 "Undefined" pieces on the cover inventory; not a filed type yet,
  // counted here so the planned total matches the 64 shown on the home page
  'Cape · 01 — Gathering The Food': { LV: 8, MV: 16, CP: 8, BW: 8, JR: 8, OB: 8, UD: 8 },
};

function plannedTotal(series: string): number {
  const inv = plannedInventory[series] ?? {};
  return Object.values(inv).reduce((a, b) => a + b, 0);
}
---

<BaseLayout
  title="Works · 作品目錄 — Earthscape Studio"
  description="Catalog of works from Earthscape Studio. 所有作品依系列、類別與藏品編號編列。"
  active="works"
>
  <Breadcrumb slot="top" current="Works" acc={`CAT · ${works.length} OF ${plannedTotal('Cape · 01 — Gathering The Food')}`} />

  <!-- HERO -->
  <section class="catalog-hero">
    <span class="label-strong">§ Catalog · 作品目錄</span>
    <h1><em>The</em> Catalog</h1>
    <div class="hero-zh zh">作 品 目 錄</div>
    <p class="hero-desc">
      All works archived by series, type and accession number.<br />
      所有作品依系列、類別與藏品編號編列。
    </p>
  </section>

  <!-- REFERENCE · CAPE · 01 -->
  <section class="series-reference">
    <SectionHead num="§ Cape · 01"><em>Gathering The Food</em> · 儲物</SectionHead>

    <div class="reference-grid">
      <figure class="reference-figure">
        <Image
          class="reference-img"
          src={seriesGroup}
          alt="Five coil-built storage vessels grouped on a cloth-covered table"
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="lazy"
        />
        <figcaption class="reference-caption label">Cape · 01 · 儲物 · 2026</figcaption>
      </figure>

      <div class="reference-note">
        <p class="zh">
          靈感來源於古地中海地區用來保存運送糧食、橄欖油與葡萄酒的器物。憨厚圓潤的外型與古樸的材質都讓我覺得十分迷人——材質可能是陶，是玄武岩，也可能是高級的雪花石膏。<br>
          從最貼近原型的大花器開始製作第一批作品，擷取並且調整成可以好好站著實用花器，期待花與葉的生命力填滿完整作品！
        </p>

        <p class="reference-stories zh">
          查找資料與製作時，有幾個有趣的小知識想分享。
        </p>

        <ol class="reference-stories zh">
          <li>
            這批器物從米黃、赭紅、深褐到近黑的強烈差異，並非來自不同的釉，而是化妝土中鐵含量的多寡——在相同的基底化妝土中，分別添加 2%～10% 不等的氧化鐵（還有微量氧化錳），最後呈現出氣質十分不同的色彩效果。
          </li>
          <li>
            雙耳罐的耳朵未必是把手——有時候看到某些高罐的耳朵小到很幽默，讓人困惑它到底是用來做什麼的；查找後才發現，在許多古代器物上，它更常是為了綁繩封口而存在。
          </li>
          <li>
            關於高瘦甚至尖底的瓶罐，一眼望去真的是看不懂它們為什麼會做成這樣站不住的造型，查找資料後才知道：它們不需要「站好」。作為儲藏的用品，它們的舞台並不是日常的桌面或是櫥櫃，而是半埋在倉庫、酒窖裡的砂土中；在船艙裡層層互相咬合、彼此支撐，穩穩度過整趟地中海的航行。
          </li>
        </ol>

        <div class="reference-keywords label">
          Egyptian · Badarian · Nagada · Enkomi · Ktima
        </div>

        <span class="reference-source label">Inspiration · Musée du Louvre · 6 objects</span>

        <ul class="reference-cards">
          {references.map((r) => (
            <li>
              <a class="ref-card" href={r.url} target="_blank" rel="noopener noreferrer">
                <span class="ref-card-inv label">{r.inv}</span>
                <span class="ref-card-title">{r.title}</span>
                <span class="ref-card-period">{r.period}</span>
                <span class="ref-card-material">{r.material}</span>
                <span class="ref-card-dim label">{r.dim}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {Array.from(bySeries.entries()).map(([series, items]) => {
    const planned = plannedInventory[series] ?? {};
    const plannedSum = plannedTotal(series);
    return (
      <section class="series-catalog">
        <div class="series-summary">
          <div class="summary-line">
            <span class="summary-num">{items.length}</span>
            <span class="summary-of label">of</span>
            <span class="summary-num">{plannedSum}</span>
            <span class="summary-label label">pieces completed</span>
          </div>
          <div class="summary-inventory">
            {typeOrder.map(t => {
              const made = items.filter(i => i.data.type === t).length;
              const total = planned[t] ?? 0;
              if (total === 0) return null;
              return (
                <div class="inv-cell">
                  <span class="inv-type label">{t}</span>
                  <span class="inv-progress">{made}/{total}</span>
                </div>
              );
            })}
          </div>
        </div>

        <div class="catalog-grid">
          {items.map(w => (
            <a href={`/works/${w.id}`} class="catalog-card">
              <div class="card-thumb">
                {w.data.images.length > 0 ? (
                  <Image
                    class="card-thumb-img"
                    src={w.data.images[0].src}
                    alt=""
                    widths={[300, 600]}
                    sizes="(max-width: 600px) 45vw, 260px"
                    loading="lazy"
                  />
                ) : (
                  <span class="thumb-glyph">◇</span>
                )}
                <span class="thumb-type label">{w.data.type} · {w.data.serial}</span>
              </div>
              <div class="card-acc label">{w.data.accession.replace(/^ES · \d+ · /, '')}</div>
              <h3 class="card-name">{w.data.title}</h3>
              <div class="card-name-zh zh">{w.data.titleZh}</div>
              {w.data.dimensions && <div class="card-dim">{w.data.dimensions}</div>}
            </a>
          ))}

          {items.length < plannedSum && (
            <div class="catalog-card planned">
              <div class="card-thumb">
                <span class="thumb-glyph">·</span>
                <span class="thumb-type label">{plannedSum - items.length} forthcoming</span>
              </div>
              <div class="card-acc label">尚未編列</div>
              <h3 class="card-name">In Production</h3>
              <div class="card-name-zh zh">製 作 中</div>
            </div>
          )}
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  /* ── Hero ── */
  .catalog-hero {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: var(--s-16) var(--gutter) var(--s-12);
    text-align: center;
    border-bottom: var(--hair);
    animation: rise 0.6s ease both;
  }

  .catalog-hero :global(.label-strong) {
    display: block;
    margin-bottom: var(--s-4);
  }

  .catalog-hero h1 {
    font-size: clamp(2.5rem, 7vw, var(--t-5xl));
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--mn-900);
    margin-bottom: var(--s-3);
  }
  .catalog-hero h1 em { color: var(--fe-500); }

  .hero-zh {
    font-size: var(--t-xl);
    color: var(--mn-700);
    letter-spacing: 0.3em;
    margin-bottom: var(--s-6);
    font-weight: 300;
  }

  .hero-desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--t-lg);
    color: var(--mn-700);
    line-height: 1.65;
    max-width: 540px;
    margin: 0 auto;
  }

  /* ── Reference ── */
  .series-reference {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: var(--s-16) var(--gutter);
    border-bottom: var(--hair);
  }

  .reference-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--s-12);
    align-items: start;
  }

  .reference-figure { margin: 0; }

  .reference-figure .reference-img {
    width: 100%;
    height: auto;
    display: block;
    border: var(--hair);
    background: var(--bg-elev);
    margin-bottom: var(--s-3);
  }

  .reference-caption { color: var(--mn-500); }

  .reference-note p {
    font-size: var(--t-base);
    line-height: 2;
    color: var(--mn-900);
    margin-bottom: var(--s-4);
  }

  .reference-stories {
    list-style: none;
    counter-reset: story;
    margin: 0 0 var(--s-6);
    padding: 0;
  }

  .reference-stories li {
    counter-increment: story;
    position: relative;
    padding-left: var(--s-8);
    margin-bottom: var(--s-4);
    font-size: var(--t-base);
    line-height: 2;
    color: var(--mn-900);
  }

  .reference-stories li:last-child { margin-bottom: 0; }

  .reference-stories li::before {
    content: counter(story, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--fe-500);
    line-height: 2.7;
  }

  .reference-keywords {
    color: var(--fe-500);
    letter-spacing: 0.22em;
    padding-bottom: var(--s-6);
    border-bottom: var(--hair);
  }

  .reference-source {
    display: block;
    color: var(--mn-500);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    margin: var(--s-6) 0 var(--s-3);
  }

  .reference-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--s-3);
  }

  .ref-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    height: 100%;
    padding: var(--s-4);
    border: var(--hair);
    background: var(--bg-elev);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }

  .ref-card:hover {
    border-color: var(--fe-500);
    background: var(--bg);
  }
  .ref-card:hover .ref-card-title { color: var(--fe-500); }

  .ref-card-inv {
    color: var(--fe-500);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    margin-bottom: var(--s-1);
  }

  .ref-card-title {
    font-family: var(--font-display);
    font-size: var(--t-base);
    line-height: 1.25;
    color: var(--mn-900);
    transition: color 0.2s;
  }

  .ref-card-period {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    line-height: 1.5;
    color: var(--mn-500);
  }

  .ref-card-material {
    font-size: var(--t-sm);
    color: var(--mn-700);
    margin-top: auto;
    padding-top: var(--s-2);
  }

  .ref-card-dim {
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    color: var(--mn-500);
  }

  @media (max-width: 900px) {
    .reference-grid { grid-template-columns: 1fr; gap: var(--s-8); }
  }

  /* ── Per-series section ── */
  .series-catalog {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: var(--s-16) var(--gutter);
    border-bottom: var(--hair);
  }

  /* ── Series summary bar ── */
  .series-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-6);
    padding: var(--s-4) 0;
    margin-bottom: var(--s-8);
    border-bottom: var(--hair);
  }

  .summary-line {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .summary-num {
    font-family: var(--font-display);
    font-size: var(--t-3xl);
    font-weight: 300;
    color: var(--fe-500);
    line-height: 1;
  }

  .summary-of {
    letter-spacing: 0.15em;
  }

  .summary-label {
    color: var(--mn-700);
    margin-left: var(--s-2);
  }

  .summary-inventory {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  .inv-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--s-2) var(--s-3);
    border: var(--hair);
    background: var(--bg-elev);
    min-width: 56px;
  }

  .inv-type {
    letter-spacing: 0.18em;
    color: var(--fe-500);
  }

  .inv-progress {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--mn-900);
    margin-top: 2px;
  }

  /* ── Grid ── */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-4);
  }

  .catalog-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .catalog-card:hover { transform: translateY(-2px); }
  .catalog-card:hover .card-thumb { border-color: var(--fe-500); }
  .catalog-card:hover .card-name { color: var(--fe-500); }

  .card-thumb {
    background: var(--bg-elev);
    border: var(--hair);
    aspect-ratio: 4 / 5;
    margin-bottom: var(--s-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    position: relative;
    transition: border-color 0.25s ease;
  }

  .thumb-glyph {
    font-family: var(--font-display);
    font-size: var(--t-5xl);
    color: var(--mn-300);
    line-height: 1;
  }

  .card-thumb-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-type {
    position: absolute;
    bottom: var(--s-3);
    left: var(--s-3);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
  }

  .card-acc {
    color: var(--fe-500);
    margin-bottom: var(--s-1);
  }

  .card-name {
    font-size: var(--t-lg);
    color: var(--mn-900);
    line-height: 1.3;
    margin-bottom: 2px;
    transition: color 0.2s;
  }

  .card-name em { color: var(--fe-500); }

  .card-name-zh {
    font-size: var(--t-sm);
    color: var(--mn-700);
    letter-spacing: 0.15em;
    margin-bottom: var(--s-1);
  }

  .card-dim {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--mn-500);
    margin-top: 2px;
  }

  /* Planned placeholder (single cumulative card showing what's forthcoming) */
  .catalog-card.planned {
    opacity: 0.55;
    cursor: default;
  }

  .catalog-card.planned:hover { transform: none; }
  .catalog-card.planned:hover .card-thumb { border-color: var(--mn-100); }
  .catalog-card.planned:hover .card-name { color: var(--mn-900); }

  .catalog-card.planned .card-thumb {
    border-style: dashed;
  }

  @media (max-width: 768px) {
    .series-catalog { padding: var(--s-12) var(--gutter); }
    .summary-num { font-size: var(--t-2xl); }
  }

  @media (max-width: 600px) {
    .catalog-hero { padding: var(--s-12) var(--gutter) var(--s-8); }
    .catalog-grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
    .thumb-glyph { font-size: var(--t-4xl); }
  }

  @media (max-width: 380px) {
    .catalog-grid { grid-template-columns: 1fr; }
  }
</style>
