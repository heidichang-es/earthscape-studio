  dialog.lightbox[open] {
    display: grid;
    grid-template-columns: 72px 1fr 72px;
    /* An explicit row is what lets the picture's max-height: 100% resolve —
       against an auto row it has nothing to measure and the image overflows. */
    grid-template-rows: 100%;
    align-items: stretch;
  }

  dialog.lightbox::backdrop { background: rgba(13, 11, 15, 0.93); }

  .lb-stage {
    grid-column: 2;
    display: grid;
    /* The track must be definite too, not just the dialog's row: a percentage
       max-height resolves against the grid AREA, and an auto track gives it
